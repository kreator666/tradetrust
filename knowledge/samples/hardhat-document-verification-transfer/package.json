{
  "name": "hardhat-document-verification-transfer",
  "version": "1.0.0",
  "private": true,
  "description": "UUPS 可升级文档验证与文档转移合约 Hardhat 样例",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "hardhat test",
    "deploy:registry": "hardhat run scripts/deploy-registry.ts --network hardhat",
    "deploy:escrow": "hardhat run scripts/deploy-escrow.ts --network hardhat",
    "upgrade:registry": "hardhat run scripts/upgrade-registry.ts --network hardhat",
    "deploy:sepolia": "hardhat run scripts/deploy-sepolia.ts --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify-sepolia.ts --network sepolia",
    "frontend": "ts-node frontend/server.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@types/chai": "^4.3.11",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.4",
    "chai": "^4.3.10",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "hardhat": "^2.22.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@openzeppelin/hardhat-upgrades": "^3.9.0",
    "ethers": "^6.13.5"
  }
}
