{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "types": ["node", "mocha", "hardhat"]
  },
  "include": ["./hardhat.config.ts", "./types", "./scripts", "./test"],
  "exclude": ["./frontend"]
}
